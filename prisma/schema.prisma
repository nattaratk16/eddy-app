// prisma/schema.prisma
// --------------------------------------------------------------
// วิธีใช้งาน:
// 1. ตั้งค่า PostgreSQL (แนะนำ Neon - ดู README หัวข้อ 4)
// 2. ใส่ connection string ใน .env และ .env.local -> DATABASE_URL="postgresql://user:pass@host/db"
// 3. รัน: npm run prisma:push   (สร้างตารางจาก schema นี้)
// 4. รัน: npm run prisma:generate (สร้าง Prisma Client)
// --------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime? // ใช้โดย NextAuth adapter (OAuth provider ยืนยันอีเมลให้อัตโนมัติ)
  name          String?
  image         String?
  bio           String? // เกี่ยวกับฉัน - แสดงในหน้าโปรไฟล์
  password      String? // เก็บแบบ hashed (bcrypt) เท่านั้น - เป็น null ได้ถ้าสมัครผ่าน Google (ไม่มีรหัสผ่าน)
  // ข้อมูลโปรไฟล์เพิ่มเติม (ทุกช่องไม่บังคับ - ออกแบบให้เป็นกลาง ใช้ได้ทั้งคนเรียนและคนทำงาน)
  username     String? @unique // ชื่อผู้ใช้ (handle) - ไม่ซ้ำกัน
  title        String? // บทบาท/ตำแหน่ง เช่น "นักศึกษาวิศวกรรม", "นักการตลาด", "ครู"
  organization String? // สถานศึกษา/ที่ทำงาน
  status       String? // "student" | "working" | "other"
  avatarColor  String? // สีพื้นอวาตาร์ (คีย์จากพาเลตพาสเทล)
  avatarEmoji  String? // อีโมจิใช้เป็นอวาตาร์ (ถ้าไม่ได้ใส่รูป)
  timezone     String? // โซนเวลา IANA เช่น "Asia/Bangkok"
  dayStart     String? // ช่วงเวลาที่สะดวกเริ่ม "HH:mm" - ป้อนให้ AI หาเวลาว่าง
  dayEnd       String? // ช่วงเวลาที่สะดวกจบ "HH:mm"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tasks         Task[]
  categories    Category[]
  events        Event[]
  messages      ChatMessage[]
  accounts      Account[]
  sessions      Session[]
  // เฟส 3: ระบบกลุ่ม
  ownedGroups      Group[]       @relation("GroupOwner")
  groupMemberships GroupMember[] @relation("GroupMemberships")
}

// ---------- ตารางมาตรฐานของ NextAuth adapter (สำหรับ Google OAuth) ----------
// รูปแบบตรงตามที่ @auth/prisma-adapter กำหนดไว้ - ห้ามเปลี่ยนชื่อ field เอง
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  priority  String    @default("medium") // "low" | "medium" | "high"
  category  String?
  dueDate   DateTime?
  estimatedMinutes Int? // ใช้คำนวณ Priority Score (แกน "ความยาก/ระยะเวลา") - ไม่บังคับกรอก
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subtasks  Subtask[]

  @@index([userId, done])
}

// รายการย่อยภายในงานหนึ่งชิ้น (checklist ง่ายๆ - แค่ชื่อ + เสร็จหรือยัง)
model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0) // ใช้จัดลำดับตอนลากสลับตำแหน่ง - เรียงตามนี้แทน createdAt
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
}

// หมวดหมู่ปฏิทิน เช่น "ปฏิทินการเรียน", "ปฏิทินการออกกำลังกาย"
model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("blue") // "pink" | "yellow" | "mint" | "blue" | "peach" | "lilac" | "amber" | "lime" | "olive" | "teal" | "sky" | "indigo" | "violet" | "plum" | "coral" | "rose"
  shared    Boolean  @default(false) // เฟส 4: เปิดแชร์หมวดหมู่นี้ให้ผู้ใช้คนอื่นเห็นหรือยัง
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  events    Event[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  startTime   String?
  endTime     String?
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  @@index([userId, date])
}

// ---------- เฟส 3: ระบบกลุ่ม (แชร์ตาราง + AI หาเวลาว่าง + กระจายงาน) ----------

// กลุ่มสำหรับทำงาน/นัดหมายร่วมกัน
model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String        @default("blue") // ใช้พาเลตพาสเทลเดียวกับ category เป็นสีประจำกลุ่ม
  ownerId     String
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  tasks       GroupTask[]
}

// สมาชิกในกลุ่ม (รวมเจ้าของด้วย) + สถานะคำเชิญ + การตั้งค่าความเป็นส่วนตัว
model GroupMember {
  id              String   @id @default(cuid())
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role            String   @default("member") // "owner" | "member"
  status          String   @default("pending") // "pending" | "accepted" | "declined"
  // ความเป็นส่วนตัว: true = โชว์ชื่อ event ให้เพื่อนในกลุ่มเห็น, false = โชว์แค่ช่วง "ไม่ว่าง"
  showEventTitles Boolean  @default(false)
  invitedById     String? // ผู้ใช้ที่เชิญ (ไว้อ้างอิง ไม่ทำ relation เพื่อความเรียบง่าย)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId, status])
}

// งานของกลุ่ม (สิ่งที่ต้องช่วยกันทำ) - รอ AI กระจายให้สมาชิก
model GroupTask {
  id               String               @id @default(cuid())
  groupId          String
  group            Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  estimatedMinutes Int                  @default(60) // ใช้คำนวณว่าต้องการช่วงว่างยาวแค่ไหน
  dueDate          DateTime? // กำหนดส่ง (ไม่บังคับ) - AI จะไม่วางเกินวันนี้
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assignment       GroupTaskAssignment?

  @@index([groupId])
}

// ผลการมอบหมายงานกลุ่ม (AI เสนอ 1 งาน → 1 คน + ช่วงเวลา) รอสมาชิก approve ลงปฏิทินตัวเอง
model GroupTaskAssignment {
  id               String    @id @default(cuid())
  groupTaskId      String    @unique
  groupTask        GroupTask @relation(fields: [groupTaskId], references: [id], onDelete: Cascade)
  assignedToUserId String
  date             String // "YYYY-MM-DD"
  startTime        String // "HH:mm"
  endTime          String // "HH:mm"
  status           String    @default("suggested") // "suggested" | "approved" | "rejected"
  approvedEventId  String? // event ที่สร้างในปฏิทินส่วนตัวตอน approve (เฟส 3d)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([assignedToUserId, status])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "eddy"
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
