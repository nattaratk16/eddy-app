// prisma/schema.prisma
// --------------------------------------------------------------
// วิธีใช้งาน:
// 1. ตั้งค่า PostgreSQL (แนะนำ Neon - ดู README หัวข้อ 4)
// 2. ใส่ connection string ใน .env และ .env.local -> DATABASE_URL="postgresql://user:pass@host/db"
// 3. รัน: npm run prisma:push   (สร้างตารางจาก schema นี้)
// 4. รัน: npm run prisma:generate (สร้าง Prisma Client)
// --------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime? // ใช้โดย NextAuth adapter (OAuth provider ยืนยันอีเมลให้อัตโนมัติ)
  name          String?
  image         String?
  bio           String? // เกี่ยวกับฉัน - แสดงในหน้าโปรไฟล์
  password      String? // เก็บแบบ hashed (bcrypt) เท่านั้น - เป็น null ได้ถ้าสมัครผ่าน Google (ไม่มีรหัสผ่าน)
  // ข้อมูลโปรไฟล์เพิ่มเติม (ทุกช่องไม่บังคับ - ออกแบบให้เป็นกลาง ใช้ได้ทั้งคนเรียนและคนทำงาน)
  username     String? @unique // ชื่อผู้ใช้ (handle) - ไม่ซ้ำกัน
  title        String? // บทบาท/ตำแหน่ง เช่น "นักศึกษาวิศวกรรม", "นักการตลาด", "ครู"
  organization String? // สถานศึกษา/ที่ทำงาน
  status       String? // "student" | "working" | "other" (ช่องเก่า - ไม่ได้ใช้แล้ว)
  role         String? // บทบาทจาก onboarding: "school" | "university" | "working" - ใช้ปรับ category/ภาษา/บริบท AI
  onboardedAt  DateTime? // เวลาที่ทำ onboarding เสร็จ/ข้าม (null = ยังไม่เคยทำ -> ให้เด้งไปหน้า onboarding)
  avatarColor  String? // สีพื้นอวาตาร์ (คีย์จากพาเลตพาสเทล)
  avatarEmoji  String? // อีโมจิใช้เป็นอวาตาร์ (ถ้าไม่ได้ใส่รูป)
  timezone     String? // โซนเวลา IANA เช่น "Asia/Bangkok"
  dayStart     String? // ช่วงเวลาที่สะดวกเริ่ม "HH:mm" - ป้อนให้ AI หาเวลาว่าง
  dayEnd       String? // ช่วงเวลาที่สะดวกจบ "HH:mm"
  skills          String[] @default([]) // ทักษะ/ความถนัด - AI ใช้จับคู่ตอนแตกงานกลุ่มแล้วมอบหมายให้สมาชิก
  maxFocusMinutes Int? // ระยะเวลาโฟกัสต่อเนื่องสูงสุด (นาที) - จำกัดขนาดขั้นตอนย่อยตอน AI แตกงาน (ไม่บังคับ)
  bufferMinutes   Int? // เว้นช่วงพักระหว่างงานที่ AI จัดลงปฏิทินให้ (นาที) - ไม่บังคับ
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tasks         Task[]
  categories    Category[]
  events        Event[]
  messages      ChatMessage[]
  accounts      Account[]
  sessions      Session[]
  // เฟส 3: ระบบกลุ่ม
  ownedGroups      Group[]       @relation("GroupOwner")
  groupMemberships GroupMember[] @relation("GroupMemberships")
  // Loop ชีวิต (กิจกรรมประจำที่ซ้ำทุกสัปดาห์)
  recurringEvents  RecurringEvent[]
}

// Loop ชีวิตพื้นฐาน - บล็อกเวลาที่ซ้ำทุกสัปดาห์ (ตารางเรียนประจำ / เวลาทำงาน)
// รองรับทั้ง 2 แบบด้วย field days (นักเรียน = หลายบล็อกเล็ก, วัยทำงาน = บล็อกใหญ่หลายวัน)
model RecurringEvent {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  courseCode String? // รหัสวิชา เช่น "01076021" (ใส่เฉพาะ Loop ที่เป็นคาบเรียน)
  days       String // วันในสัปดาห์แบบ "1,2,3,4,5" (0=อาทิตย์ .. 6=เสาร์)
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"
  categoryId String? // อ้างอิงหมวดหมู่ (เก็บเป็น string ไม่ทำ FK เพื่อไม่ให้ลบหมวดแล้วลบ loop ตาม)
  endDate    DateTime? // ใช้ถึงวันไหน (เช่น สิ้นเทอม) - null = ตลอดไป
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

// ---------- ตารางมาตรฐานของ NextAuth adapter (สำหรับ Google OAuth) ----------
// รูปแบบตรงตามที่ @auth/prisma-adapter กำหนดไว้ - ห้ามเปลี่ยนชื่อ field เอง
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  // เวลาที่ติ๊กว่าเสร็จจริงๆ (null = ยังไม่เสร็จ) - แยกจาก updatedAt เพราะ updatedAt เปลี่ยน
  // ทุกครั้งที่แก้อะไรก็ตาม ไม่ใช่แค่ตอนติ๊กเสร็จ ใช้ตัดหน้า "เสร็จแล้ว" เป็นรายเดือนได้แม่นยำ
  completedAt DateTime?
  priority  String    @default("medium") // "low" | "medium" | "high"
  category  String?
  dueDate   DateTime?
  // เวลาส่งของวันกำหนดส่ง "HH:mm" (ไม่บังคับ)
  // null = ไม่ระบุเวลา -> หมุดกำหนดส่งในปฏิทินจะขึ้นเป็นกิจกรรมทั้งวัน
  dueTime   String?
  // วันที่เริ่มลงมือ (ค่าเริ่มต้น = วันที่เพิ่มงาน แต่ผู้ใช้แก้ได้)
  // ใช้เป็นขอบล่างของช่วงเวลาที่เอ็ดดี้กระจายงานย่อย: startDate -> dueDate
  startDate DateTime?
  estimatedMinutes Int? // ใช้คำนวณ Priority Score (แกน "ความยาก/ระยะเวลา") - ไม่บังคับกรอก
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subtasks  Subtask[]

  // งานที่เอ็ดดี้จัดลงปฏิทินให้แล้ว -> ผูกกับ event ที่สร้างขึ้น (null = ยังไม่ได้ลงปฏิทิน)
  // onDelete: SetNull -> ถ้าผู้ใช้ลบ event นั้นในหน้าปฏิทิน งานจะกลับมาเป็น "ยังไม่ได้จัดลงปฏิทิน" อัตโนมัติ
  scheduledEventId String? @unique
  scheduledEvent   Event?  @relation("TaskSchedule", fields: [scheduledEventId], references: [id], onDelete: SetNull)

  // หมุด "วันต้องส่ง" ในปฏิทิน — คนละใบกับ scheduledEvent ที่เป็น "ช่วงลงมือทำ"
  // ขึ้นเฉพาะเมื่อวันกำหนดส่งยังไม่มีกิจกรรมของงานนี้อยู่ (กันซ้ำ)
  deadlineEventId String? @unique
  deadlineEvent   Event?  @relation("TaskDeadline", fields: [deadlineEventId], references: [id], onDelete: SetNull)

  @@index([userId, done])
  @@index([userId, completedAt])
}

// รายการย่อยภายในงานหนึ่งชิ้น (checklist ง่ายๆ - แค่ชื่อ + เสร็จหรือยัง)
model Subtask {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0) // ใช้จัดลำดับตอนลากสลับตำแหน่ง - เรียงตามนี้แทน createdAt
  // แผนว่าควรทำงานย่อยนี้ "เมื่อไหร่" - เอ็ดดี้เสนอให้ตอนแตกงาน แล้วผู้ใช้ปรับแก้เองได้
  // null = ยังไม่ได้วางแผน (เช่น งานที่ไม่มีกำหนดส่ง หรือผู้ใช้เพิ่มรายการย่อยเอง)
  plannedDate DateTime?
  startTime   String? // "HH:mm"
  endTime     String? // "HH:mm"
  estimatedMinutes Int? // ความยาวที่เอ็ดดี้ประเมินไว้ ใช้ตอนคำนวณว่าจะวางลงช่องว่างไหน
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  // ขั้นตอนย่อยที่ถูกวางลงปฏิทินแล้ว (แยก event ของตัวเอง คนละใบกับ event ของงานหลัก)
  // onDelete: SetNull -> ลบ event ในหน้าปฏิทิน แล้วขั้นตอนนี้กลับมาเป็น "ยังไม่ได้ลงปฏิทิน" เอง
  scheduledEventId String? @unique
  scheduledEvent   Event?  @relation("SubtaskSchedule", fields: [scheduledEventId], references: [id], onDelete: SetNull)

  // Prisma ไม่สร้าง index ให้ foreign key อัตโนมัติ - ใส่เองเพราะถูก query ด้วย taskId ตลอด
  // (findMany/count ในทุกฟังก์ชันของ lib/taskCalendar.ts และ breakdown/plan route)
  @@index([taskId])
}

// หมวดหมู่ปฏิทิน เช่น "ปฏิทินการเรียน", "ปฏิทินการออกกำลังกาย"
model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("blue") // "pink" | "yellow" | "mint" | "blue" | "peach" | "lilac" | "amber" | "lime" | "olive" | "teal" | "sky" | "indigo" | "violet" | "plum" | "coral" | "rose"
  // "academic" | "non_academic" - เดาอัตโนมัติจากชื่อตอนสร้าง (lib/categoryKind.ts) ผู้ใช้แก้ไขเองได้ภายหลังถ้าเดาผิด
  // ใช้แยกภาระงานวิชาการ/ไม่ใช่วิชาการในกราฟภาระงานกลุ่ม (WorkloadPanel)
  kind      String   @default("non_academic")
  shared    Boolean  @default(false) // เฟส 4: เปิดแชร์หมวดหมู่นี้ให้ผู้ใช้คนอื่นเห็นหรือยัง
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  events    Event[]

  // ensureTaskCategory() ใน lib/taskCalendar.ts เช็คหมวดหมู่นี้ทุกครั้งที่ลงปฏิทินจากงาน
  @@index([userId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  startTime   String?
  endTime     String?
  location    String?
  description String?
  // สีเฉพาะของ event นี้ (ทับสีของหมวดหมู่) - null = ใช้สีหมวดหมู่ตามปกติ
  // ใช้กับงานจาก To-do: แต่ละงานได้สีของตัวเองจะได้ไม่กลืนกันทั้งปฏิทิน
  color       String?

  // งานใน To-do ที่เป็นต้นทางของ event นี้ (null = ผู้ใช้สร้างเองในปฏิทิน)
  // เก็บ "ที่มา" ไว้บน event ตรงๆ แทนที่จะพึ่งลิงก์ฝั่ง Task/Subtask อย่างเดียว
  // เพราะถ้าลิงก์ขาด (เขียนไม่สำเร็จกลางคัน) event จะกลายเป็นกำพร้าที่ตามเก็บไม่ได้เลย
  // มีคอลัมน์นี้แล้วลบงานทีเดียวเก็บกวาดได้ครบเสมอด้วย query เดียว
  sourceTaskId String?

  // true = เป็น "หมุดวันต้องส่ง" ไม่ใช่ช่วงเวลาที่ต้องลงมือทำจริง (ระยะเวลา 0 นาที)
  // ต้องแยกจาก event/งานจริงทั้งฝั่งแสดงผล (ห้ามเป็นกล่องทึบกินพื้นที่สเกลเวลา)
  // และฝั่งตรรกะ AI/หาเวลาว่าง (ห้ามนับเป็นเวลาไม่ว่างหรือถือว่าตารางชนกัน)
  isDeadline   Boolean @default(false)

  @@index([userId, sourceTaskId])
  @@index([userId, isDeadline])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String

  // ฝั่งตรงข้ามของ Task.scheduledEvent (event นี้ถูกสร้างจากงานใน To-do หรือเปล่า)
  scheduledForTask Task? @relation("TaskSchedule")
  // ฝั่งตรงข้ามของ Subtask.scheduledEvent (event นี้ถูกสร้างจากขั้นตอนย่อยหรือเปล่า)
  scheduledForSubtask Subtask? @relation("SubtaskSchedule")
  // ฝั่งตรงข้ามของ Task.deadlineEvent (event นี้เป็นหมุดวันต้องส่งหรือเปล่า)
  deadlineForTask     Task?    @relation("TaskDeadline")

  @@index([userId, date])
}

// ---------- เฟส 3: ระบบกลุ่ม (แชร์ตาราง + AI หาเวลาว่าง + กระจายงาน) ----------

// กลุ่มสำหรับทำงาน/นัดหมายร่วมกัน
model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  color       String        @default("blue") // ใช้พาเลตพาสเทลเดียวกับ category เป็นสีประจำกลุ่ม
  // รหัสเข้าร่วมกลุ่ม 6 ตัว (เช่น "K7M2QD") - ใครมีรหัสก็เข้ากลุ่มได้เองโดยไม่ต้องรอเจ้าของเชิญ
  // เป็น null ได้เพราะกลุ่มที่สร้างก่อนมีฟีเจอร์นี้ยังไม่มีรหัส (สร้างให้ตอนเปิดใช้ครั้งแรก)
  joinCode    String?       @unique
  ownerId     String
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  tasks       GroupTask[]
}

// สมาชิกในกลุ่ม (รวมเจ้าของด้วย) + สถานะคำเชิญ + การตั้งค่าความเป็นส่วนตัว
model GroupMember {
  id              String   @id @default(cuid())
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("GroupMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role            String   @default("member") // "owner" | "member"
  status          String   @default("pending") // "pending" | "accepted" | "declined"
  // ความเป็นส่วนตัว: true = โชว์ชื่อ event ให้เพื่อนในกลุ่มเห็น, false = โชว์แค่ช่วง "ไม่ว่าง"
  showEventTitles Boolean  @default(false)
  invitedById     String? // ผู้ใช้ที่เชิญ (ไว้อ้างอิง ไม่ทำ relation เพื่อความเรียบง่าย)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId, status])
}

// งานของกลุ่ม (สิ่งที่ต้องช่วยกันทำ) - รอ AI กระจายให้สมาชิก
model GroupTask {
  id               String               @id @default(cuid())
  groupId          String
  group            Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  estimatedMinutes Int                  @default(60) // ใช้คำนวณว่าต้องการช่วงว่างยาวแค่ไหน
  dueDate          DateTime? // กำหนดส่ง (ไม่บังคับ) - AI จะไม่วางเกินวันนี้
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assignment       GroupTaskAssignment?

  // ติ๊กว่าเสร็จงานจริงหรือยัง - คนละแกนกับ assignment.status (ที่บอกแค่ "ลงปฏิทินหรือยัง")
  // เฉพาะ assignment.assignedToUserId เท่านั้นที่ติ๊กได้ (ดู PATCH /api/groups/[id]/tasks/[taskId])
  done        Boolean   @default(false)
  completedAt DateTime?

  @@index([groupId])
  @@index([groupId, done])
}

// ผลการมอบหมายงานกลุ่ม (AI เสนอ 1 งาน → 1 คน + ช่วงเวลา) รอสมาชิก approve ลงปฏิทินตัวเอง
model GroupTaskAssignment {
  id               String    @id @default(cuid())
  groupTaskId      String    @unique
  groupTask        GroupTask @relation(fields: [groupTaskId], references: [id], onDelete: Cascade)
  assignedToUserId String
  date             String // "YYYY-MM-DD"
  startTime        String // "HH:mm"
  endTime          String // "HH:mm"
  status           String    @default("suggested") // "suggested" | "approved" | "rejected"
  // "auto" (ปุ่มให้เอ็ดดี้จัดตาราง) | "manual" (เลือกเองตอนแตกงาน/จากรายการ)
  // /distribute จะไม่แตะของที่ source="manual" กันโดนแย่งคืนตอนกด "ให้เอ็ดดี้จัดตาราง" ทีหลัง
  source           String    @default("auto")
  approvedEventId  String? // event ที่สร้างในปฏิทินส่วนตัวตอน approve (เฟส 3d)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([assignedToUserId, status])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // "user" | "eddy"
  text      String
  // การ์ด "เอ็ดดี้อ่านได้ว่า..." ที่แนบมากับข้อความ เก็บเป็น JSON string
  // (เก็บไว้ด้วยเพื่อให้เปิดแชทใหม่แล้วยังกดเพิ่มลงปฏิทิน/สิ่งที่ต้องทำต่อได้)
  // ไม่เก็บตัวเลือกเวลาที่เสนอ เพราะช่องว่างเปลี่ยนตลอด ต้องคำนวณใหม่เสมอ
  draft     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId, createdAt])
}
